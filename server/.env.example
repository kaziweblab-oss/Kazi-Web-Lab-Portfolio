# Your local device env here not for Production
PORT=<Your Port Name is Here>
HOSTNAME=<Your Hostname is Here>

# mongodb variable here
DBURL=<Your Mongodb Database Url String>


# jwt variable here
JWT_SECRET=<node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ImageKit variable here
IMAGEKIT_PUBLIC_KEY= <Your ImageKit Public Key Here>
IMAGEKIT_PRIVATE_KEY= <Your ImageKit Private Key Here>
IMAGEKIT_URL_ENDPOINT= <Your ImageKit Endpoint Here>
IMAGEKIT_URL_ENDPOINT= <Your ImageKit Endpoint Here>

# Client/Front-End env
CLIENT_URL=<Your Client/Front-End URL Here>